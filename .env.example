# SQL Server admin login: loader scripts and scripts/create_sql_logins.py only, never the app
SQL_ADMIN_USER=username
SQL_ADMIN_PASSWORD=password

# SQL Server read-only database login the app connects with (not a user sign-in);
# created by scripts/create_sql_logins.py. The password must meet SQL Server's policy
# (8+ characters with upper, lower, digit and symbol) and must not contain ; { } ' or "
SQL_APP_USER=app_reader
SQL_APP_PASSWORD=password

# Database Settings
# SQL_SERVER_HOST=localhost/public_ip
SQL_SERVER_PORT=1433
# Optional: ODBC driver name (default: SQL Server)
# SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# PostgreSQL (our data: customers, journeys, orders)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_agent
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Optional: database the tests drop and rebuild on every run (default: POSTGRES_DB + "_test").
# Lowercase letters, digits and underscores, ending in _test.
# POSTGRES_TEST_DB=sales_agent_test

# Optional: the only origin allowed to send POST, PUT, PATCH and DELETE (default: http://localhost:8000)
# ALLOWED_ORIGIN=http://localhost:8000

# Optional: database time limit in seconds and pool sizes (defaults: 5, 5, 10)
# DB_QUERY_TIMEOUT_SECONDS=5
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10