SQL_ADMIN_USER=username
SQL_ADMIN_PASSWORD=password

# Database Settings
# SQL_SERVER_HOST=localhost/public_ip
SQL_SERVER_PORT=1433

# PostgreSQL (our data: customers, journeys, orders)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_agent
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Optional: database the tests drop and rebuild on every run (default: POSTGRES_DB + "_test").
# Must differ from POSTGRES_DB.
# POSTGRES_TEST_DB=sales_agent_test